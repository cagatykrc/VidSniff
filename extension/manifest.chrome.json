{
  "manifest_version": 3,
  "name": "VidSniff — Video Download Manager",
  "version": "1.7.0",
  "description": "EN: Catch streams & save MP4. TR: Akışı yakala, MP4 olarak kaydet.",
  "permissions": [
    "webRequest",
    "downloads",
    "storage",
    "tabs",
    "scripting",
    "cookies",
    "notifications",
    "webNavigation"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://127.0.0.1:17890/*",
    "http://localhost:17890/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "VidSniff",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["i18n-global.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
